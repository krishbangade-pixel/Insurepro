.env
.env.local
.env.production
.env.development
.env.staging
.env.*.local
*.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
.DS_Store
Thumbs.db
*.pem

# Testing
coverage/
.nyc_output/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Misc
.vercel
.turbo